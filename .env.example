# --- Chain access (read-only) -------------------------------------------------
# Primary RPC used by the indexer, verifier RPC must be an independent provider.
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_VERIFIER_RPC_URL=
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_VERIFIER_RPC_URL=

# --- Public site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ascertain.example

# --- x402 pay-per-answer -----------------------------------------------------
# Leave X402_PAY_TO empty to run in demo mode (signatures are verified locally,
# nothing is settled on-chain). Set it to your receiving address to settle via a facilitator.
X402_PAY_TO=
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Optional AI commentary (can only downgrade a verdict, never upgrade) ----
ANTHROPIC_API_KEY=
